#:kivy 2.0
# How custom widgets are drawn. The Python classes are in rsh/ui/widgets/.

<LevelMeter>:
    canvas:
        # Background track
        Color:
            rgba: 0.18, 0.18, 0.22, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6)]
        # Filled part: green normally, red when very loud
        Color:
            rgba: (0.3, 0.85, 0.4, 1) if self.level < 0.85 else (0.95, 0.3, 0.25, 1)
        RoundedRectangle:
            pos: self.pos
            size: max(dp(12), self.width * self.level) if self.level > 0 else 0, self.height
            radius: [dp(6)]

# A reusable big button style
<MenuButton@Button>:
    size_hint_y: None
    height: dp(64)
    font_size: sp(22)
    background_normal: ""
    background_color: 0.25, 0.35, 0.9, 1
